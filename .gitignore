# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bild-Rohdaten der Demo
scripts/.raw/

.vercel
.env*

# agent tooling
.agents/
.claude/
# Arbeitsspuren des Werkzeugs, nicht der Vorlage: Fortschrittsnotizen,
# Diffs vergangener Sitzungen, Zwischenstaende als HTML - drei Megabyte, die
# beim naechsten Rechner ohnehin anders aussehen. Der Ordner sagt es selbst:
# .superpowers/sdd/.gitignore enthaelt nur ein Sternchen.
.superpowers/
skills-lock.json

# PHP-Fassung: lokale Konfiguration und Datenauszug
php/config.php
php/config.php.*
php/data/export.json

# Gerenderte Kartenbilder und die Koordinaten dazu. Cache, kein Quelltext:
# er baut sich beim ersten Aufruf neu auf (src/StaticMap.php).
php/data/cache/
# Hochgeladene Bilder gehoeren dem Betrieb, nicht dem Repo.
# Die Schutzregeln des Ordners muessen aber mit aufs Ziel.
php/public/uploads/*
!php/public/uploads/.htaccess
